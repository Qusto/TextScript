# OpenRouter API Configuration
OPENAI_API_KEY=your_openrouter_api_key_here

# LLM Model (default: openai/gpt-4o-mini)
# Options: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, etc.
MODEL=openai/gpt-4o-mini

# Content Limits
MAX_URLS=10
MAX_CONTENT_LENGTH_PER_URL=5000
MAX_TOTAL_CONTENT_LENGTH=8000

# URL Fetching
URL_FETCH_TIMEOUT=30

# Research Enhancement (US7)
# Enable research stage to enrich articles with facts, quotes, and current data
RESEARCH_ENABLED=false
# Research model (options: perplexity/sonar-pro, perplexity/sonar, openai/gpt-4o-mini)
RESEARCH_MODEL=perplexity/sonar-pro

# Logging
LOG_LEVEL=INFO
