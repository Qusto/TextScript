# AICODE-NOTE: T009 - Ignore generated artifacts and temporary files
# AICODE-NOTE: These directories contain runtime outputs that shouldn't be version controlled

# Generated corpus (user-provided texts)
corpus/

# Generated evaluation dataset (test cases)
eval_dataset/

# Evaluation results (metrics and reports)
eval_results/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Poetry
poetry.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables (should use root .env)
.env
.env.local

# Jupyter notebooks (if used for analysis)
.ipynb_checkpoints/
*.ipynb

# Temporary files
tmp/
temp/
*.tmp
